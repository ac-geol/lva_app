# ---------------------------------------------------------------------------
# DATA: deny by default.
#
# Nothing carrying coordinates, hole IDs or grades gets committed on this
# project -- raw tables AND derived files. The repo is public, so the safe
# direction is the only direction: every CSV is ignored, with no exceptions,
# and a new data file is never staged by accident. See CLAUDE.md section 2.
# ---------------------------------------------------------------------------
*.csv

# Drop your own tables here -- never tracked.
data/

# Notebook prototype: cell outputs carry hole IDs, UTM coordinates and
# georeferenced figures from a second, non-public deposit. Kept local only.
lva_notebook_v1.ipynb
lva_notebook_v1.md
lva_notebook_v1_files/

# ---------------------------------------------------------------------------
# Everything else
# ---------------------------------------------------------------------------

# Virtualenv -- rebuilt from requirements.txt, never committed (219 MB).
.venv/

# Python bytecode and test caches
__pycache__/
*.py[cod]
.pytest_cache/

# OS noise
.DS_Store

# Script outputs -- figures and result tables, all regenerated on demand.
out/

# Browser app build artifacts -- regenerate with scripts/build_app.py.
# (app/sample_synthetic.csv is already covered by the blanket *.csv rule.)
app/core.zip
app/pyodide/
app/three/
